#X obj 60 242 *~ 0.5;
#X obj 60 280 *~;
#X obj 60 320 dac~ 5;
#X obj 180 365 scope 100;
#X obj 420 365 scope 100;
#X obj 60 365 scope 100;
#X obj 660 25 loadbang;
#X msg 660 60 100;
#X obj 660 95 hsl 162 19 60 200 1 0 empty empty XOVER-Hz -2 -10 0 12 #fcfcfc #000000 #000000 0 1;
#X msg 660 145 1;
#X obj 660 180 hsl 162 19 0 2 0 0 empty empty TOPS-trim -2 -10 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 660 215 pack 0 20;
#X obj 660 248 line~;
#X obj 660 290 hsl 162 19 0 2 0 0 empty empty SUB-trim -2 -10 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 660 325 pack 0 20;
#X obj 660 358 line~;
#X text 200 45 Music player L/R -> tops (highpassed) + ONE mono sub;
#X text 180 135 TOP L - ch 3;
#X text 420 135 TOP R - ch 4;
#X text 130 320 SUB \, mono - ch 5;
#X text 130 242 L low + R low summed \, x0.5 so the mono sum stays at unity instead of +6 dB;
#X text 660 390 Trims MUST init: the *~ right inlets are signals \, so an unset line~ outputs 0 = silence. The loadbang above is load-bearing.;
#X text 660 460 Was stereo lows on ch 5 AND 6 \, which loses half the bass into a single mono sub. Now summed to ch 5 only \; ch 6 is free.;
#X text 60 530 Crossover lives in xover-lr4.pd (Linkwitz-Riley 4th order \, bands sum flat). Shared with separate-speakers.pd.;
