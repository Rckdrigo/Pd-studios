#X obj 880 150 pack 0 20;
#X obj 880 182 line~;
#X obj 880 218 hsl 162 19 0 2 0 0 empty empty HIGH-trim -2 -10 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 880 253 pack 0 20;
#X obj 880 285 line~;
#X text 190 20 Music player L/R \, split into low + high bands;
#X text 58 68 L low - ch 5;
#X text 198 68 L high - ch 3;
#X text 338 68 R low - ch 6;
#X text 478 68 R high - ch 4;
#X text 650 290 Linkwitz-Riley 4th order: two cascaded Butterworth sections per band \, coefficients recomputed from the slider. 24 dB/oct \, and the two bands sum flat to 0.00 dB so there is no notch at the crossover.;
#X text 880 320 Trims MUST init: the *~ right inlet is a signal \, so an unset line~ outputs 0 = silence.;
