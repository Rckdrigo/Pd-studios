#X obj 650 218 expr 2*cos(2*3.14159265*\$f1/\$f2)/(1+sin(2*3.14159265*\$f1/\$f2)*0.70710678) \; -(1-sin(2*3.14159265*\$f1/\$f2)*0.70710678)/(1+sin(2*3.14159265*\$f1/\$f2)*0.70710678) \; (1+cos(2*3.14159265*\$f1/\$f2))/2/(1+sin(2*3.14159265*\$f1/\$f2)*0.70710678) \; -(1+cos(2*3.14159265*\$f1/\$f2))/(1+sin(2*3.14159265*\$f1/\$f2)*0.70710678) \; (1+cos(2*3.14159265*\$f1/\$f2))/2/(1+sin(2*3.14159265*\$f1/\$f2)*0.70710678);
