#N canvas 150 120 900 640 12;
#X obj 40 45 adc~ 15 16;
#X obj 40 90 +~;
#X obj 40 125 *~ 0.5;
#X obj 40 170 xover-lr4;
#X obj 40 220 env~ 4096;
#X obj 200 220 env~ 4096;
#X obj 360 220 env~ 4096;
#X obj 40 255 - 50;
#X obj 40 285 / 50;
#X obj 40 315 max 0;
#X obj 40 345 min 1;
#X obj 200 255 - 50;
#X obj 200 285 / 50;
#X obj 200 315 max 0;
#X obj 200 345 min 1;
#X obj 360 255 - 50;
#X obj 360 285 / 50;
#X obj 360 315 max 0;
#X obj 360 345 min 1;
#X obj 40 385 oscformat audio bass;
#X obj 200 385 oscformat audio treble;
#X obj 360 385 oscformat audio level;
#X obj 40 420 list prepend send;
#X obj 200 420 list prepend send;
#X obj 360 420 list prepend send;
#X obj 40 455 list trim;
#X obj 200 455 list trim;
#X obj 360 455 list trim;
#X obj 40 530 netsend -u -b;
#X obj 620 45 loadbang;
#X msg 620 85 connect localhost 6010;
#X msg 620 130 200;
#X msg 620 175 \; pd dsp 1;
#X text 200 45 Music L/R from BlackHole via the aggregate device;
#X text 130 125 summed to mono -- one analysis chain is enough;
#X text 130 170 reuses the speaker crossover as an analysis splitter;
#X text 40 200 BASS;
#X text 200 200 TREBLE;
#X text 360 200 LEVEL;
#X text 470 285 env~ gives dB referenced to RMS 1.0 \, so a full-scale sine measures 97 \, not 100 (measured). (dB-50)/50 maps a 50..100 dB window onto 0..1 \, then clamped -- which leaves a little headroom at the top.;
#X text 470 385 Same OSC chain as midi-osc-bridge.pd. Sends /audio/bass \, /audio/treble \, /audio/level.;
#X text 620 220 Analysis split at 200 Hz -- unrelated to the speaker crossover \, change freely.;
#X text 40 560 env~ 4096 emits every 2048 samples \, about 21 Hz at 44.1k. Plenty for visuals \, gentle on the network -- no metro needed.;
#X text 470 130 IMPORTANT: Pd must be started with at least 16 input channels or adc~ 15 16 is silently dead.;
#X connect 0 0 1 0;
