#N canvas 60 40 1200 1180 12;
#X obj 40 40 adc~ 15 16;
#X obj 40 100 +~;
#X obj 40 150 *~ 0.5;
#X obj 40 210 xover-lr4;
#X obj 420 210 hip~ 300;
#X obj 420 260 lop~ 3400;
#X obj 40 280 bonk~;
#X obj 40 340 unpack f f f;
#X floatatom 40 400 6 0 0 0 - - - 0;
#X obj 180 280 bng 19 250 50 0 empty empty BEAT 0 -10 0 12 #fcfcfc #000000 #000000;
#X obj 40 460 hsl 162 19 0 2 0 0 empty empty BEAT-trim -2 -10 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 230 460 tgl 19 0 empty empty BEAT-mute 22 8 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 40 510 trim-ctl;
#X obj 40 560 *~;
#X obj 40 610 dac~ 7;
#X obj 420 460 hsl 162 19 0 2 0 0 empty empty VOCAL-trim -2 -10 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 610 460 tgl 19 0 empty empty VOCAL-mute 22 8 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 420 510 trim-ctl;
#X obj 420 560 *~;
#X obj 420 610 dac~ 8;
#X obj 420 320 sigmund~;
#X floatatom 420 380 6 0 0 0 - - - 0;
#X obj 560 380 mtof;
#X floatatom 560 430 7 0 0 0 - - - 0;
#X floatatom 700 380 7 0 0 0 - - - 0;
#X obj 900 150 env~;
#X floatatom 900 200 7 0 0 0 - - - 0;
#X obj 900 300 loadbang;
#X msg 900 340 1;
#X msg 900 380 \; pd dsp 1;
#X msg 900 420 150;
#X text 40 15 BEAT + approximate VOCAL isolation + song-analysis numbers -- read top to bottom \, left column is BEAT \, middle column is VOCAL \, right column is overall LEVEL / init. Notes for each section are listed below the graph., f 1050;
#X text 40 240 BEAT column, f 100;
#X text 420 240 VOCAL column, f 100;
#X text 900 120 LEVEL / INIT, f 150;
#X text 40 680 INPUT -- reads Music L/R off the same 16-ch BlackHole aggregate device as separate-speakers.pd / audio-osc-bridge.pd. Start Pd with at least 16 input channels or adc~ 15 16 is silently dead., f 1050;
#X text 40 730 BEAT -- xover-lr4 fixed at ~150 Hz (see the "150" message on the right)\, the same trick separate-speakers.pd uses for its SUB band. This is kick/bass content\, not an isolated drum stem., f 1050;
#X text 40 780 BEAT NUMBER -- bonk~ only fires its "cooked" list when it detects a percussive attack in the beat band. Each firing is one hit: the bng flashes and the number is attack velocity (how hard it hit)., f 1050;
#X text 40 830 VOCAL (approximate) -- bandpass ~300-3400 Hz on the mono sum\, the range where vocal presence lives. NOT true source separation -- it also passes guitar\, snare\, anything else in that band. Real isolation needs an offline ML model (Demucs / Spleeter)\, outside what Pd DSP can do live., f 1050;
#X text 40 900 VOCAL NUMBERS -- sigmund~ tracks whichever partial is loudest inside the vocal band\, usually the lead vocal/melody if it's prominent\, but it has no real concept of "voice." Outlet 0 = pitch in MIDI (converted to Hz alongside it)\, outlet 1 = amplitude in dB., f 1050;
#X text 40 950 LEVEL -- env~ on the full mono mix gives the overall song level\, same idiom as the LEVEL analysis in audio-osc-bridge.pd., f 1050;
#X text 40 1000 OUTPUTS -- channels 7/8 are placeholders: separate-speakers.pd already owns ch 1/2/3 and minilab.pd owns ch 5/6. Use whatever is free on your interface and edit the dac~ args., f 1050;
#X text 40 1050 INIT -- loadbang seeds both trims to unity gain\, sets the beat crossover to 150 Hz\, and turns DSP on. Trims MUST init or the *~ right inlets output silence., f 1050;
