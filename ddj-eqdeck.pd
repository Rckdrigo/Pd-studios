#N canvas 40 40 560 220 12;
#X text 20 5 [ddj-eqdeck N] - splits deck N audio (send~ dN-audio) into 4 bands for the pad graphic EQ: low \, low-mid \, high-mid \, high = pad columns 1-4;
#X obj 20 40 receive~ d\$1-audio;
#X obj 20 80 lop~ 120;
#X obj 20 105 lop~ 120;
#X obj 140 80 bp~ 500 2;
#X obj 260 80 bp~ 2500 2;
#X obj 380 80 hip~ 7000;
#X obj 380 105 hip~ 7000;
#X obj 20 140 ddj-eqband \$1 0;
#X obj 140 140 ddj-eqband \$1 1;
#X obj 260 140 ddj-eqband \$1 2;
#X obj 380 140 ddj-eqband \$1 3;
#X connect 1 0 2 0;
#X connect 1 0 4 0;
#X connect 1 0 5 0;
#X connect 1 0 6 0;
#X connect 2 0 3 0;
#X connect 3 0 8 0;
#X connect 4 0 9 0;
#X connect 5 0 10 0;
#X connect 6 0 7 0;
#X connect 7 0 11 0;
