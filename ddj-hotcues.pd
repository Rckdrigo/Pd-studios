#N canvas 40 40 1200 900 12;
#X text 20 5 [ddj-hotcues N] - 8 hot cue pads for deck N. inlets: phasor~ phase \, length \, samplerate \, track bpm \, first beat (s). outlet: phase to jump to. sends lights-step (16th note on the track grid \, wrapped to 0-127 = 8 bars so the grid also runs before the detected first beat) while this deck leads the light show;
#X obj 20 40 inlet~;
#X obj 160 40 inlet;
#X obj 300 40 inlet;
#X obj 440 40 inlet;
#X obj 580 40 inlet;
#X obj 20 70 metro 10;
#X obj 20 100 snapshot~;
#X obj 20 130 t f f;
#X obj 100 160 v \$0-pos;
#X obj 20 190 expr if(\$f4>0 \, fmod(fmod(floor((\$f1*\$f2/max(\$f3 \, 1)-\$f5)*\$f4/15) \, 128)+128 \, 128) \, -1);
#X obj 20 220 change;
#X obj 20 250 spigot;
#X obj 20 280 s lights-step;
#X obj 160 130 t f f;
#X obj 240 160 v \$0-len;
#X obj 160 220 s \$0-clear;
#X obj 700 40 r d\$1-eject;
#X obj 700 70 t b b;
#X msg 780 100 0;
#X obj 20 340 r \$0-clear;
#X obj 20 370 t b b;
#X msg 100 400 const 0;
#X obj 100 430 s ddjhc\$1;
#X obj 20 430 s lights-refresh;
#X text 250 340 cue tables ddjhc1 / ddjhc2 live in ddj-lightshow;
#X obj 700 160 r d\$1-state;
#X obj 700 190 t b f f;
#X obj 860 220 v \$0-play;
#X obj 780 220 sel 1;
#X obj 780 250 f \$1;
#X obj 840 250 f \$1;
#X obj 840 275 expr 3-\$f1;
#X obj 780 305 v lightsmaster;
#X obj 700 335 s lights-gate;
#X obj 900 40 r lights-gate;
#X obj 900 65 v \$0-play;
#X obj 900 90 expr \$f1 && lightsmaster==\$1;
#X obj 900 115 change;
#X obj 900 140 t f f;
#X obj 900 165 sel 0 1;
#X msg 900 190 -1;
#X msg 980 190 set -2;
#X obj 20 500 r d\$1-hotcue-on;
#X obj 20 525 expr if(padmode\$1 \, -1 \, \$f1-1);
#X obj 20 550 moses 8;
#X obj 20 575 moses 0;
#X obj 80 600 t f f;
#X obj 80 625 tabread ddjhc\$1;
#X obj 80 650 sel 0;
#X obj 80 680 v \$0-len;
#X obj 80 705 moses 1;
#X obj 140 730 t b;
#X obj 140 755 v \$0-pos;
#X obj 140 780 + 1;
#X obj 140 805 t b f;
#X obj 220 850 tabwrite ddjhc\$1;
#X obj 140 880 s lights-refresh;
#X obj 300 680 - 1;
#X obj 300 705 t b f;
#X obj 400 850 outlet;
#X obj 300 730 v \$0-play;
#X obj 300 755 sel 0;
#X msg 300 780 127;
#X obj 300 805 s d\$1-play;
#X obj 500 500 r d\$1-hotcue-off;
#X obj 500 525 expr if(padmode\$1 \, -1 \, \$f1-1);
#X obj 500 550 moses 8;
#X obj 500 575 moses 0;
#X obj 500 600 t b b f;
#X msg 520 630 0;
#X obj 1100 40 loadbang;
#X obj 1100 65 t b b;
