#N canvas 40 40 900 450 12;
#X text 20 5 [ddj-lightshow] - drives all 16 DDJ-200 pad lights. stored hot cues stay lit. while a deck plays the pads run a sequence on its beat grid: one step per 16th note \, a new pattern every 2 bars (chase \, ping-pong \, fill \, checkerboard);
#X obj 20 40 r lights-step;
#X obj 20 65 t b f;
#X obj 100 90 v lightstep;
#X obj 200 40 r lights-refresh;
#X obj 20 120 t b b;
#X msg 100 145 0;
#X msg 20 145 16;
#X obj 20 170 until;
#X obj 20 195 f;
#X obj 60 195 + 1;
#X obj 20 220 t f f f;
#X obj 300 250 expr 8+2*int(\$f1/8);
#X obj 160 280 expr (if(\$f1<8 \, ddjhc1[\$f1] \, ddjhc2[\$f1-8])>0) || (lightstep>=0 && if(fmod(int(lightstep/32) \, 4)==0 \, \$f1==fmod(lightstep \, 16) \, if(fmod(int(lightstep/32) \, 4)==1 \, \$f1==if(fmod(lightstep \, 32)<16 \, fmod(lightstep \, 32) \, 31-fmod(lightstep \, 32)) \, if(fmod(int(lightstep/32) \, 4)==2 \, \$f1<=fmod(lightstep \, 16) \, fmod(fmod(\$f1 \, 4)+int(fmod(\$f1 \, 8)/4)+int(lightstep/2) \, 2)==0))));
#X obj 160 310 * 127;
#X obj 20 310 expr fmod(\$f1 \, 8);
#X obj 20 350 noteout;
#X obj 500 40 table ddjhc1 8;
#X obj 650 40 table ddjhc2 8;
#X connect 1 0 2 0;
#X connect 2 1 3 0;
#X connect 2 0 5 0;
#X connect 4 0 5 0;
#X connect 5 1 6 0;
#X connect 6 0 9 1;
#X connect 5 0 7 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 9 0 10 0;
#X connect 10 0 9 1;
#X connect 9 0 11 0;
#X connect 11 2 12 0;
#X connect 12 0 16 2;
#X connect 11 1 13 0;
#X connect 13 0 14 0;
#X connect 14 0 16 1;
#X connect 11 0 15 0;
#X connect 15 0 16 0;
