#N canvas 40 40 900 450 12;
#X text 20 5 [ddj-lightshow] - drives all 16 DDJ-200 pad lights. stored hot cues stay lit. while a deck plays the pads run a sequence on its beat grid: one step per 16th note \, a new pattern every 2 bars (chase \, ping-pong across the 8 columns \, fill \, checkerboard). menu: auto (cycles them) \, one fixed pattern \, eq (per deck: columns = low \, low-mid \, high-mid \, high \, height = level) \, eq rows (bottom row = bass \, top row = treble \, filling left to right) or off (cues only);
#X obj 20 40 r lights-step;
#X obj 20 65 t b f;
#X obj 100 90 v lightstep;
#X obj 200 40 r lights-refresh;
#X obj 20 120 t b b;
#X msg 100 145 0;
#X msg 20 145 16;
#X obj 20 170 until;
#X obj 20 195 f;
#X obj 60 195 + 1;
#X obj 20 220 t f f f;
#X obj 300 250 expr 8+2*int(\$f1/8);
#X obj 160 280 expr (if(\$f1<8 \, ddjhc1[\$f1] \, ddjhc2[\$f1-8])>0) || (lightmode==5 && if(\$f1<8 \, eqh1[fmod(\$f1 \, 4)] \, eqh2[fmod(\$f1 \, 4)])>=3-int(fmod(\$f1 \, 8)/4)) || (lightmode==6 && if(\$f1<8 \, if(fmod(\$f1 \, 8)>=4 \, max(eqh1[0] \, eqh1[1]) \, max(eqh1[2] \, eqh1[3])) \, if(fmod(\$f1 \, 8)>=4 \, max(eqh2[0] \, eqh2[1]) \, max(eqh2[2] \, eqh2[3])))>fmod(\$f1 \, 4)) || (lightstep>=0 && lightmode<5 && if(if(lightmode==0 \, fmod(int(lightstep/32) \, 4) \, lightmode-1)==0 \, \$f1==fmod(lightstep \, 16) \, if(if(lightmode==0 \, fmod(int(lightstep/32) \, 4) \, lightmode-1)==1 \, int(\$f1/8)*4+fmod(fmod(\$f1 \, 8) \, 4)==if(fmod(lightstep \, 16)<8 \, fmod(lightstep \, 16) \, 15-fmod(lightstep \, 16)) \, if(if(lightmode==0 \, fmod(int(lightstep/32) \, 4) \, lightmode-1)==2 \, \$f1<=fmod(lightstep \, 16) \, fmod(fmod(\$f1 \, 4)+int(fmod(\$f1 \, 8)/4)+int(lightstep/2) \, 2)==0))));
#X obj 160 310 * 127;
#X obj 20 310 expr fmod(\$f1 \, 8);
#X obj 20 350 noteout;
#X obj 500 40 table ddjhc1 8;
#X obj 650 40 table ddjhc2 8;
#X obj 1000 40 cnv 15 200 22 empty empty empty 20 12 0 14 #202020 #404040 0;
#X obj 1002 42 hradio 18 1 1 8 empty empty empty 0 -8 0 10 #fcfcfc #000000 #000000 0;
#X obj 1152 42 cnv 1 1 1 empty \$0-name auto 0 9 0 12 #202020 #ffffff 0;
#X obj 1000 200 t b f f;
#X obj 1100 230 v lightmode;
#X obj 1000 260 sel 0 1 2 3 4 5 6;
#X msg 1000 290 label auto;
#X msg 1000 315 label chase;
#X msg 1000 340 label ping-pong;
#X msg 1000 365 label fill;
#X msg 1000 390 label checker;
#X msg 1000 415 label off;
#X obj 1000 445 s \$0-name;
#X obj 900 230 s lights-refresh;
#X msg 1100 415 label eq;
#X obj 900 260 expr \$f1==5 || \$f1==6;
#X obj 900 285 metro 50;
#X obj 800 40 table eqh1 4;
#X obj 800 70 table eqh2 4;
#X obj 500 100 ddj-eqdeck 1;
#X obj 650 100 ddj-eqdeck 2;
#X msg 1100 440 label eq rows;
#X obj 1250 200 r d1-pfl;
#X obj 1250 225 moses 1;
#X msg 1300 250 -1;
#X obj 1350 200 r d2-pfl;
#X obj 1350 225 moses 1;
#X msg 1400 250 1;
#X obj 1300 280 expr (lightmode+\$f1+8)%8;
#X obj 1450 200 r master-headmix;
#X obj 1450 225 moses 1;
#X obj 1500 280 expr if(lightmode==7 \, lightlast \, 7);
#X obj 1100 260 moses 7;
#X obj 1100 285 v lightlast;
