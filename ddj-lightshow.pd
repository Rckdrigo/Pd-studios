#N canvas 40 40 900 450 12;
#X text 20 5 [ddj-lightshow] - drives all 16 DDJ-200 pad lights. stored hot cues stay lit. while a deck plays the pads run a sequence on its beat grid: one step per 16th note \, a new pattern every 2 bars (chase \, ping-pong across the 8 columns \, fill \, checkerboard). menu: auto (cycles them) \, one fixed pattern \, or off (cues only);
#X obj 20 40 r lights-step;
#X obj 20 65 t b f;
#X obj 100 90 v lightstep;
#X obj 200 40 r lights-refresh;
#X obj 20 120 t b b;
#X msg 100 145 0;
#X msg 20 145 16;
#X obj 20 170 until;
#X obj 20 195 f;
#X obj 60 195 + 1;
#X obj 20 220 t f f f;
#X obj 300 250 expr 8+2*int(\$f1/8);
#X obj 160 280 expr (if(\$f1<8 \, ddjhc1[\$f1] \, ddjhc2[\$f1-8])>0) || (lightstep>=0 && lightmode<5 && if(if(lightmode==0 \, fmod(int(lightstep/32) \, 4) \, lightmode-1)==0 \, \$f1==fmod(lightstep \, 16) \, if(if(lightmode==0 \, fmod(int(lightstep/32) \, 4) \, lightmode-1)==1 \, int(\$f1/8)*4+fmod(fmod(\$f1 \, 8) \, 4)==if(fmod(lightstep \, 16)<8 \, fmod(lightstep \, 16) \, 15-fmod(lightstep \, 16)) \, if(if(lightmode==0 \, fmod(int(lightstep/32) \, 4) \, lightmode-1)==2 \, \$f1<=fmod(lightstep \, 16) \, fmod(fmod(\$f1 \, 4)+int(fmod(\$f1 \, 8)/4)+int(lightstep/2) \, 2)==0))));
#X obj 160 310 * 127;
#X obj 20 310 expr fmod(\$f1 \, 8);
#X obj 20 350 noteout;
#X obj 500 40 table ddjhc1 8;
#X obj 650 40 table ddjhc2 8;
#X obj 1000 40 cnv 15 200 22 empty empty empty 20 12 0 14 #202020 #404040 0;
#X obj 1002 42 hradio 18 1 1 6 empty empty empty 0 -8 0 10 #fcfcfc #000000 #000000 0;
#X obj 1116 42 cnv 1 1 1 empty \$0-name auto 0 9 0 12 #202020 #ffffff 0;
#X obj 1000 200 t b f f;
#X obj 1100 230 v lightmode;
#X obj 1000 260 sel 0 1 2 3 4;
#X msg 1000 290 label auto;
#X msg 1000 315 label chase;
#X msg 1000 340 label ping-pong;
#X msg 1000 365 label fill;
#X msg 1000 390 label checker;
#X msg 1000 415 label off;
#X obj 1000 445 s \$0-name;
#X obj 900 230 s lights-refresh;
