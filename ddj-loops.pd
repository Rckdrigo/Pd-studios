#X obj 410 495 v lp\$1a;
#X obj 300 470 expr if(\$f1==1 \, 0 \, if(\$f1==2 \, if((lp\$1a>=0 && lp\$1b>lp\$1a) \, 1 \, lp\$1on) \, if(\$f1==3 \, if(lp\$1on==1 \, 0 \, (lp\$1a>=0 && lp\$1b>lp\$1a)) \, lp\$1on))) \; if(\$f1==1 \, 1 \, if(\$f1==2 \, if((lp\$1a>=0 && lp\$1b>lp\$1a) \, 2 \, lp\$1pad) \, if(\$f1==3 \, if(lp\$1on==1 \, 0 \, if((lp\$1a>=0 && lp\$1b>lp\$1a) \, 2 \, lp\$1pad)) \, lp\$1pad))) \; if((lp\$1a>=0 && lp\$1b>lp\$1a) && (\$f1==2 || (\$f1==3 && lp\$1on!=1)) \, lp\$1b-lp\$1a \, lp\$1L) \; if((lp\$1a>=0 && lp\$1b>lp\$1a) && (\$f1==2 || (\$f1==3 && lp\$1on!=1)) \, lp\$1a \, lp\$1s) \; if(lp\$1on==1 && lp\$1p>=lp\$1s && (\$f1==1 || \$f1==3) \, lp\$1s+fmod(lp\$1p+lp\$1f/max(lp\$1sr \, 1)-lp\$1s \, max(lp\$1L \, 1e-09)) \, if(\$f1==3 && lp\$1on!=1 && (lp\$1a>=0 && lp\$1b>lp\$1a) \, lp\$1a \, -1));
