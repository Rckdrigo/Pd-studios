#N canvas 40 40 420 200 12;
#X text 120 20 [ddj-pad ch] - note number of each pad press on one channel. right outlet: note number of each release;
#X obj 20 20 notein \$1;
#X obj 20 60 stripnote;
#X obj 20 100 outlet;
#X obj 200 60 pack 0 0;
#X obj 200 85 expr if(\$f2 == 0 \, \$f1 \, -1);
#X obj 200 110 moses 0;
#X obj 260 140 outlet;
#X connect 1 0 2 0;
#X connect 1 1 2 1;
#X connect 2 0 3 0;
#X connect 1 0 4 0;
#X connect 1 1 4 1;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 6 1 7 0;
