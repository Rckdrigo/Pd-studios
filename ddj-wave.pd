#N canvas 40 40 1000 650 12;
#X text 20 5 [ddj-wave N \$0-of-deck] - waveform for the web page: when a track has loaded (inlets: length \, samplerate) reads the deck tables \$2-L / \$2-R as peak bins (100 per second \, evenly over the track) \, 50 bins per ms so the other deck keeps playing \, and sends them as dN-wave;
#X obj 20 40 inlet;
#X obj 300 40 inlet;
#X obj 300 65 v wave\$1sr;
#X obj 20 65 t b f;
#X obj 100 90 v wave\$1n;
#X obj 20 90 t b b b;
#X msg 200 150 0;
#X obj 120 120 expr max(ceil(wave\$1n*100/max(wave\$1sr \, 1)) \, 1);
#X obj 120 145 t f f;
#X obj 20 180 metro 1;
#X msg 20 205 50;
#X obj 20 230 until;
#X obj 20 255 f;
#X obj 60 255 + 1;
#X obj 20 280 expr if(\$f1 < wave\$1N \, \$f1 \, -1);
#X obj 20 305 moses 0;
#X obj 80 330 t f f;
#X obj 80 355 expr int(\$f1*wave\$1n/wave\$1N) \; max(int((\$f1+1)*wave\$1n/wave\$1N)-int(\$f1*wave\$1n/wave\$1N) \, 1);
#X obj 80 385 t f f f f;
#X obj 80 420 array max \$2-L;
#X obj 220 420 array min \$2-L;
#X obj 360 420 array max \$2-R;
#X obj 500 420 array min \$2-R;
#X obj 80 455 expr int(max(max(\$f1 \, -\$f2) \, max(\$f3 \, -\$f4))*100+0.5)/100;
#X obj 200 175 v wave\$1N;
#X obj 120 175 array size \$0-wave;
#X obj 700 40 table \$0-wave;
#X obj 80 490 tabwrite \$0-wave;
#X obj 600 300 t b b b;
#X msg 640 330 stop;
#X obj 600 530 array get \$0-wave;
#X obj 600 560 ddj-ui-tap d\$1-wave;
#X obj 800 300 r d\$1-eject;
#X obj 800 330 t b b;
#X text 600 480 peak = the loudest sample of either channel in each bin \, rounded to 0.01 (the page scales it to the loudest bin);
