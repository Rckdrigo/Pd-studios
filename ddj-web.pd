#N canvas 40 40 1000 700 12;
#X text 20 5 [ddj-web] - link to the web page (node ddj-web/server.mjs connects on TCP 9010 \, only from this Mac). in: RECEIVER ARGS... is sent to that receiver (same messages the controller makes). out: everything sent to ddj-ui plus the readouts below. signal inlets: master L R for the scope;
#X obj 20 60 netreceive;
#X obj 20 90 t a a;
#X obj 120 120 list split 1;
#X obj 20 150 list split 1;
#X obj 20 190 s;
#X obj 20 260 r ddj-ui;
#X obj 20 290 list prepend send;
#X obj 20 315 list trim;
#X obj 300 60 r d1-loweq;
#X obj 300 85 ddj-ui-tap d1-loweq;
#X obj 440 60 r d1-mideq;
#X obj 440 85 ddj-ui-tap d1-mideq;
#X obj 580 60 r d1-higheq;
#X obj 580 85 ddj-ui-tap d1-higheq;
#X obj 720 60 r d1-volume;
#X obj 720 85 ddj-ui-tap d1-volume;
#X obj 860 60 r d2-loweq;
#X obj 860 85 ddj-ui-tap d2-loweq;
#X obj 300 140 r d2-mideq;
