#X obj 440 140 r d2-higheq;
#X obj 440 165 ddj-ui-tap d2-higheq;
#X obj 580 140 r d2-volume;
#X obj 580 165 ddj-ui-tap d2-volume;
#X obj 720 140 r master-crossfader;
#X obj 720 165 ddj-ui-tap master-crossfader;
#X obj 860 140 r master-level;
