#X obj 300 260 r lights-refresh;
#X obj 300 285 t b b b;
#X obj 500 315 expr lightmode;
#X obj 500 340 ddj-ui-tap lights-mode;
#X obj 400 365 array get ddjhc1;
#X obj 400 390 ddj-ui-tap d1-cues;
#X obj 300 415 array get ddjhc2;
#X obj 300 440 ddj-ui-tap d2-cues;
#X obj 20 480 inlet~;
#X obj 100 480 inlet~;
#X obj 20 510 +~;
#X obj 20 535 *~ 0.5;
#X obj 20 600 tabwrite~ \$0-scope;
#X obj 250 600 array define \$0-scope 512;
#X obj 120 480 metro 50;
#X obj 120 455 loadbang;
#X obj 120 505 t b b;
#X obj 200 535 array get \$0-scope;
#X obj 200 560 ddj-ui-tap scope;
