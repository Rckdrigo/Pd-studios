#N canvas 1843 192 860 640 12;
#X text 20 10 DDJ-200 two-deck DJ. Quit rekordbox first \, pick the audio output in Media > Audio Settings and set MIDI in + out to the DDJ-200 in Media > MIDI Settings.;
#X obj 20 60 ddj200-map;
#X obj 130 60 ddj-lightshow;
#X obj 20 95 ddj-deck 1;
#X obj 360 95 ddj-deck 2;
#X obj 360 270 ddj-mixer;
#X obj 20 270 ddj-browser;
#X obj 720 400 scope;
#X text 20 500 controller: jog edge = browse songs \, SHIFT+jog = move in the song \, touch the top = scratch \, SYNC = beat sync \, SHIFT+SYNC = load into a paused deck \, TRANSITION FX = echo on the deck you fade out \, CFX = filter \, pads = hot cues \, CUE 1 / CUE 2 = previous / next light mode \, MASTER CUE = lights off / on;
#X connect 3 0 5 0;
#X connect 3 1 5 1;
#X connect 4 0 5 2;
#X connect 4 1 5 3;
#X connect 5 0 7 0;
#X connect 5 1 7 0;
