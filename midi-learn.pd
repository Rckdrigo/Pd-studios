#N canvas 200 150 760 470 12;
#X obj 30 30 ctlin;
#X obj 200 80 t f f;
#X obj 200 130 spigot;
#X obj 200 190 == -1;
#X obj 30 250 spigot;
#X obj 30 290 / 127;
#X obj 420 30 inlet;
#X obj 30 340 outlet;
#X obj 330 250 outlet;
#X text 480 30 arm learn (1) \, then move a knob;
#X text 30 380 value \, 0..1;
#X text 330 290 the CC it bound to;
#X text 420 130 ctlin fires right-to-left \, so the controller number is out before the value. That lets the number decide \, in the same event \, whether the value is allowed through.;
#X text 420 210 == holds the learned CC. It starts at -1 \, which no controller sends \, so nothing passes until you learn one.;
#X connect 0 1 1 0;
#X connect 1 1 2 0;
#X connect 6 0 2 1;
#X connect 2 0 3 1;
#X connect 2 0 8 0;
#X connect 1 0 3 0;
#X connect 3 0 4 1;
#X connect 0 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 7 0;
