#N canvas 276 104 900 590 12;
#X obj 60 45 adc~ 1 2;
#X obj 60 100 xover-lr4;
#X obj 300 100 xover-lr4;
#X obj 180 150 *~;
#X obj 420 150 *~;
#X obj 180 190 dac~ 1;
#X obj 420 190 dac~ 2;
#X obj 60 200 +~;
#X obj 60 237 *~ 0.5;
#X obj 60 275 *~;
#X obj 60 315 dac~ 3;
#X obj 180 360 scope 100;
#X obj 420 360 scope 100;
#X obj 60 360 scope 100;
#X obj 660 25 loadbang;
#X msg 660 60 100;
#X obj 660 95 hsl 162 19 60 200 1 0 empty empty XOVER-Hz -2 -10 0 12 #fcfcfc #000000 #000000 0 1;
#X msg 660 145 1;
#X obj 660 180 hsl 162 19 0 2 0 0 empty empty MAIN-trim -2 -10 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 660 215 pack 0 20;
#X obj 660 248 line~;
#X obj 660 290 hsl 162 19 0 2 0 0 empty empty SUB-trim -2 -10 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 660 325 pack 0 20;
#X obj 660 358 line~;
#X text 200 45 Stereo in -> mains (highpassed) + ONE mono sub;
#X text 180 130 MAIN L - ch 1;
#X text 420 130 MAIN R - ch 2;
#X text 130 315 SUB \, mono - ch 3;
#X text 130 237 L low + R low summed \, x0.5 so the mono sum stays at unity instead of +6 dB;
#X text 660 390 Trims MUST init: the *~ right inlets are signals \, so an unset line~ outputs 0 = silence. The loadbang above is load-bearing.;
#X text 660 460 WARNING: Low-Hit-Balancer.pd also writes to ch 3 (its HIGH band). Do not run both patches at once until you settle one channel map.;
#X text 60 530 Mains are highpassed \, so they stop wasting excursion on bass the sub is already covering. Bands sum flat -- see xover-lr4.pd.;
