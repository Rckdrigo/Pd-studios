#N canvas 151 209 1060 640 12;
#X obj 40 45 adc~ 15 16;
#X obj 60 110 xover-lr4;
#X obj 300 110 xover-lr4;
#X obj 180 160 *~;
#X obj 420 160 *~;
#X obj 180 200 dac~ 1;
#X obj 420 200 dac~ 2;
#X obj 60 210 +~;
#X obj 60 247 *~ 0.5;
#X obj 60 285 *~;
#X obj 60 325 dac~ 3;
#X obj 300 250 env~;
#X obj 300 285 - 100;
#X obj 300 320 vu 15 120 empty empty -1 -8 0 10 #404040 #000000 1 0;
#X obj 150 370 env~;
#X obj 150 405 - 100;
#X obj 150 440 vu 15 120 empty empty -1 -8 0 10 #404040 #000000 1 0;
#X obj 620 25 loadbang;
#X msg 620 58 100;
#X obj 620 92 hsl 162 19 60 200 1 0 empty empty XOVER-Hz -2 -10 0 12 #fcfcfc #000000 #000000 0 1;
#X msg 620 138 1;
#X obj 620 172 hsl 162 19 0 2 0 0 empty empty MAIN-trim -2 -10 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 810 172 tgl 19 0 empty empty MAIN-mute 22 8 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 620 208 trim-ctl;
#X obj 620 252 hsl 162 19 0 2 0 0 empty empty SUB-trim -2 -10 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 810 252 tgl 19 0 empty empty SUB-mute 22 8 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 620 288 trim-ctl;
#X obj 620 340 midi-learn;
#X obj 810 340 tgl 19 0 empty empty learn-SUB 22 8 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 620 376 * 2;
#X obj 620 420 midi-learn;
#X obj 810 420 tgl 19 0 empty empty learn-XOVER 22 8 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 620 456 expr 60*pow(3.33333 \, \$f1);
#X text 200 45 Music L/R read straight off the aggregate device;
#X text 180 140 MAIN L - ch 1;
#X text 420 140 MAIN R - ch 2;
#X text 130 325 SUB \, mono - ch 3;
#X text 130 247 L low + R low summed \, x0.5 so the mono sum stays at unity instead of +6 dB;
#X text 335 250 MAINS meter;
#X text 185 370 SUB meter;
#X text 335 440 vu is fed env~ minus 100 \, the standard Pd idiom. Its red zone is your clip warning -- the trims reach 2.0 \, which is +6 dB \, so this is easy to hit.;
#X text 870 172 With only two bands \, the two mutes give you solo for free: mute the mains to solo the sub \, which is how you check the crossover point by ear.;
#X text 870 340 To bind a knob: tick learn \, move the knob \, untick. It binds that CC only and ignores every other control.;
#X text 620 490 Output map \, now the only one in the repo: mains on ch 1/2 \, mono sub on ch 3. Low-Hit-Balancer.pd was a duplicate of this patch that claimed ch 3 for its tops \; it was deleted rather than reconciled.;
#X text 620 550 Trims MUST init: the *~ right inlets are signals \, so an unset line~ outputs 0 = silence. The loadbang above is load-bearing.;
