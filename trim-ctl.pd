#N canvas 200 150 700 420 12;
#X obj 30 30 inlet;
#X obj 250 30 inlet;
#X obj 250 70 == 0;
#X obj 250 110 t b f;
#X obj 30 160 f;
#X obj 30 200 * 1;
#X obj 30 240 pack 0 20;
#X obj 30 280 line~;
#X obj 30 320 outlet~;
#X text 30 60 gain (0..2);
#X text 320 30 mute (0/1);
#X text 330 200 t b f sends the factor RIGHT outlet first \, then bangs the stored gain \, so muting re-evaluates immediately instead of waiting for the next slider move.;
#X text 330 280 20 ms ramp -- mutes and trims fade instead of clicking.;
#X text 30 355 signal gain \, ready for a *~ right inlet;
#X connect 0 0 4 0;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 3 1 5 1;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
