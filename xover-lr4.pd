#N canvas 200 100 900 560 12;
#X obj 30 30 inlet~;
#X obj 300 30 inlet;
#X obj 300 65 t f b;
#X obj 430 100 samplerate~;
#X obj 300 140 expr 2*cos(2*3.14159265*\$f1/\$f2)/(1+sin(2*3.14159265*\$f1/\$f2)*0.70710678) \; -(1-sin(2*3.14159265*\$f1/\$f2)*0.70710678)/(1+sin(2*3.14159265*\$f1/\$f2)*0.70710678) \; (1-cos(2*3.14159265*\$f1/\$f2))/2/(1+sin(2*3.14159265*\$f1/\$f2)*0.70710678) \; (1-cos(2*3.14159265*\$f1/\$f2))/(1+sin(2*3.14159265*\$f1/\$f2)*0.70710678) \; (1-cos(2*3.14159265*\$f1/\$f2))/2/(1+sin(2*3.14159265*\$f1/\$f2)*0.70710678), f 62;
#X obj 300 250 pack f f f f f;
#X obj 300 290 expr 2*cos(2*3.14159265*\$f1/\$f2)/(1+sin(2*3.14159265*\$f1/\$f2)*0.70710678) \; -(1-sin(2*3.14159265*\$f1/\$f2)*0.70710678)/(1+sin(2*3.14159265*\$f1/\$f2)*0.70710678) \; (1+cos(2*3.14159265*\$f1/\$f2))/2/(1+sin(2*3.14159265*\$f1/\$f2)*0.70710678) \; -(1+cos(2*3.14159265*\$f1/\$f2))/(1+sin(2*3.14159265*\$f1/\$f2)*0.70710678) \; (1+cos(2*3.14159265*\$f1/\$f2))/2/(1+sin(2*3.14159265*\$f1/\$f2)*0.70710678), f 62;
#X obj 300 400 pack f f f f f;
#X obj 30 440 biquad~;
#X obj 30 470 biquad~;
#X obj 150 440 biquad~;
#X obj 150 470 biquad~;
#X obj 30 510 outlet~;
#X obj 150 510 outlet~;
#X text 30 65 Linkwitz-Riley 4th-order crossover. Two cascaded Butterworth sections per band \, so the low and high outputs sum flat -- no notch at the crossover.;
#X text 30 110 inlet 0: signal. inlet 1: crossover Hz.;
#X text 30 135 outlet 0: LOW. outlet 1: HIGH.;
#X text 250 510 The cutoff inlet re-reads samplerate~ on every change \, so this is safe at any sample rate and needs no loadbang.;
